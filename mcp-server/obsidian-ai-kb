#!/bin/sh
set -eu

ROOT="${OBSIDIAN_AI_HOME:-$HOME/.local/share/obsidian-ai-kb}"
ENV_FILE="${OBSIDIAN_AI_ENV_FILE:-$ROOT/env}"

if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
fi

PYTHON="${OBSIDIAN_AI_PYTHON:-$ROOT/.venv/bin/python}"
if [ ! -x "$PYTHON" ]; then
  PYTHON=$(command -v python3)
fi

exec "$PYTHON" "$ROOT/obsidian_ai_kb.py"
