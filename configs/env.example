# Required for your vault. This default matches this repository's original layout.
OBSIDIAN_AI_PATH="$HOME/Documents/obsidian/zyk的obsidian仓库/AI"

# Rebuildable SQLite index.
OBSIDIAN_AI_INDEX="$HOME/.local/share/obsidian-ai-kb/index-v3.sqlite3"

# Optional retrieval enhancement. Default search is keyword and never needs a model service.
OBSIDIAN_AI_ENABLE_EMBEDDINGS="false"
OBSIDIAN_AI_MIN_SEMANTIC_SCORE="0.55"

# OpenAI-compatible embeddings endpoint.
OBSIDIAN_AI_EMBED_BASE_URL="http://192.168.2.100:1234/v1"
OBSIDIAN_AI_EMBED_MODEL="text-embedding-nomic-embed-text-v2-moe"
OBSIDIAN_AI_EMBED_TIMEOUT="30"
OBSIDIAN_AI_EMBED_BATCH_SIZE="32"

# Optional if the endpoint requires authentication.
# OBSIDIAN_AI_EMBED_API_KEY=""

# Nomic-style task prefixes. Set both to empty if your model does not use them.
OBSIDIAN_AI_EMBED_QUERY_PREFIX="search_query: "
OBSIDIAN_AI_EMBED_DOCUMENT_PREFIX="search_document: "

OBSIDIAN_AI_TIMEZONE="Asia/Shanghai"
OBSIDIAN_AI_SYNC_INTERVAL="2"
OBSIDIAN_AI_MAX_NOTE_CHARS="6000"
OBSIDIAN_AI_CHUNK_CHARS="1600"
OBSIDIAN_AI_CHUNK_OVERLAP="180"

# Comma-separated glob patterns, relative to the vault root.
OBSIDIAN_AI_EXCLUDE=".obsidian/**,.trash/**,**/.git/**,**/.DS_Store"
OBSIDIAN_AI_SENSITIVE="敏感信息*.md,**/敏感信息*.md,secrets*.md,**/secrets*.md,*api key*.md,**/*api key*.md"

# Managed notes are ALWAYS read-only. Built-in protection cannot be disabled.
# kb_sensitive_lookup reads headings and secret:// references without indexing/embedding bodies.
# OBSIDIAN_AI_ALLOW_SENSITIVE is obsolete and has no effect.
